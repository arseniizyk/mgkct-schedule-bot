ENV=dev # dev, prod

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token # или TELEGRAM_TOKEN
BOT_HEALTH_PORT=8081
BOT_WEB_APP_URL=https://your-domain.com # Публичный HTTPS URL для Telegram Mini App

# База данных SQLite (файл на диске)
DB_PATH=bot.db

# Умный планировщик скрапера (Smart Polling)
SCRAPER_INTERVAL=1m
SCRAPER_PEAK_INTERVAL=25s
SCRAPER_NIGHT_INTERVAL=20m
