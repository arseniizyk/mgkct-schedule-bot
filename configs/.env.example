ENV=dev # dev, prod

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
BOT_HEALTH_PORT=8081
BOT_WEB_APP_URL=https://your-domain.com # Публичный HTTPS URL для Telegram Mini App
BOT_API_URL= # Необязательно: кастомный URL Telegram Bot API (например, Cloudflare Worker прокси)
BOT_ADMIN_IDS=123456789,987654321 # Telegram Chat ID администраторов через запятую
BOT_WEBHOOK_URL= # Необязательно: публичный HTTPS URL вебхука (напр. https://example.com/telegram/webhook). Если не задан — используется Long Polling
BOT_WEBHOOK_SECRET= # Необязательно: секрет для верификации запросов от Telegram (X-Telegram-Bot-Api-Secret-Token)

# База данных SQLite (файл на диске)
DB_PATH=bot.db

# MTProto (для отправки нативных интерактивных виджетов расписания)
MTPROTO_ENABLED=true # false — отключить MTProto и использовать только WebApp фолбэк
MTPROTO_APP_ID=2040
MTPROTO_APP_HASH=b18441a1ff607e10a989891a5462e627
MTPROTO_SESSION_PATH=data/mtproto.session
MTPROTO_PROXY_URL= # Необязательно: SOCKS5 прокси (например: socks5://user:pass@127.0.0.1:1080)
MTPROTO_MTPROXY_ADDR= # Необязательно: адрес MTProxy сервера (host:port)
MTPROTO_MTPROXY_SECRET= # Необязательно: hex-секрет MTProxy сервера

# Умный планировщик скрапера (Smart Polling)
SCRAPER_INTERVAL=1m
SCRAPER_PEAK_INTERVAL=25s
SCRAPER_NIGHT_INTERVAL=20m
